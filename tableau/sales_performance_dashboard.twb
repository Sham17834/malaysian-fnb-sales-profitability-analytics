      </column>
      <column caption='Gross Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_0065484131684353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([net_sales]) != 0 THEN&#13;&#10;    SUM([gross_profit]) / SUM([net_sales])&#13;&#10;END' />
      </column>
      <column caption='Total Product Cost' datatype='real' name='[Calculation_0065484131831810]' role='measure' type='quantitative'>
