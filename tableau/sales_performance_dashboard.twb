      <column caption='Profit per Item' datatype='real' name='[Calculation_0065484131889155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([quantity]) != 0 THEN&#13;&#10;    SUM([gross_profit]) / SUM([quantity])&#13;&#10;END' />
